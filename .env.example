# =============================================================================
# .env — Tyk OSS + OpenTelemetry + New Relic
# =============================================================================

# =============================================================================
# Docker Compose
# =============================================================================

COMPOSE_PROJECT_NAME=tyk-otel-newrelic

# =============================================================================
# Environment
# =============================================================================

ENVIRONMENT=development

# =============================================================================
# New Relic
# =============================================================================

NR_LICENSE_KEY=eu01xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxNRAL
NR_OTLP_ENDPOINT=otlp.eu01.nr-data.net

# =============================================================================
# OpenTelemetry Collector
# =============================================================================

OTEL_VERSION=0.100.0

OTEL_COLLECTOR_HOST=otel-collector

OTEL_COLLECTOR_FLUENTD_PORT=24224

# =============================================================================
# Tyk Gateway
# =============================================================================

TYK_VERSION=v5.12.0

# Gateway secrets

TYK_SECRET=tyk-secret-change-me
TYK_NODE_SECRET=tyk-node-secret-change-me

# Public HTTPS port

TYK_PORT=443

# Logging
# debug | info | warn | error

TYK_LOG_LEVEL=info
TYK_GW_LOGFORMAT=json
TYK_GW_ACCESSLOGS_ENABLED=true

# OpenTelemetry

TYK_GW_OTEL_ENABLED=true
TYK_GW_OTEL_EXPORTER=grpc
TYK_GW_OTEL_ENDPOINT=otel-collector:4317
TYK_GW_OTEL_RESOURCE_NAME=tyk-gateway
TYK_GW_ACCESSLOGS_TEMPLATE=method,path,status,latency_total,latency_gateway,upstream_latency,trace_id,response_flag,response_code_details,error_source,error_target,upstream_status,upstream_addr
TYK_GW_OTEL_CONTEXT_PROPAGATION=tracecontext
TYK_GW_OTEL_CUSTOM_TRACE_HEADERS="X-Request-ID,X-B3-Traceid,X-B3-Spanid,X-B3-Parentspanid,X-B3-Sampled,X-B3-Flags,traceparent,tracestate"
TYK_GW_OPENTELEMETRY_CONNECTIONTIMEOUT=10

# Trace headers propagation

TYK_GW_OTEL_CUSTOM_TRACE_HEADERS=X-Request-ID,X-B3-Traceid,X-B3-Spanid,X-B3-Parentspanid,X-B3-Sampled,X-B3-Flags,traceparent,tracestate


# =============================================================================
# Optional Debug / Development
# =============================================================================

TYK_GW_TRACK404LOGS=true

# =============================================================================
# Tyk -Credentials basic 
# =============================================================================
USERNAME_API_USERS=admin
PASSWORD_API_USERS=admin

USERNAME_API_ORDERS=orders
PASSWORD_API_ORDERS=orders

# =============================================================================
# REDIS
# =============================================================================
REDIS_PORT=6379

