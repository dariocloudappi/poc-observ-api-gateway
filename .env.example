# =============================================================================
# .env.example - Tyk OSS + Tyk Pump + OpenTelemetry + New Relic
# -----------------------------------------------------------------------------
# Copy to .env and replace every CHANGE_ME placeholder. .env is git ignored and
# must never be committed. None of the values below are usable as they are.
#
# Generate strong secrets with:
#   openssl rand -hex 32
# =============================================================================

# =============================================================================
# Docker Compose / environment identity
# =============================================================================

COMPOSE_PROJECT_NAME=tyk-otel-newrelic

# Value of the deployment.environment resource attribute in New Relic.
ENVIRONMENT=local

# Value of the service.namespace resource attribute in New Relic.
SERVICE_NAMESPACE=poc-observability

# =============================================================================
# New Relic
# =============================================================================

# Ingest license key. Never commit a real key. New Relic keys end with NRAL.
NR_LICENSE_KEY=CHANGE_ME_NEW_RELIC_INGEST_LICENSE_KEY

# OTLP endpoint. EU accounts: https://otlp.eu01.nr-data.net:4318
# US accounts: https://otlp.nr-data.net:4318
NR_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net:4318

# =============================================================================
# OpenTelemetry Collector
# =============================================================================

OTEL_VERSION=0.100.0

# Collector self telemetry verbosity: debug | info | warn | error
OTEL_TELEMETRY_LOG_LEVEL=info

# Endpoints scraped by the collector, in host:port form.
REDIS_ENDPOINT=tyk-redis:6379
TYK_PUMP_METRICS_ENDPOINT=tyk-pump:9090

# =============================================================================
# Redis
# =============================================================================

REDIS_HOST=tyk-redis

# Port inside the container network.
REDIS_INTERNAL_PORT=6379

# Port published on 127.0.0.1 of the host, for troubleshooting only.
REDIS_PORT=6379

# =============================================================================
# Tyk Gateway
# =============================================================================

TYK_VERSION=v5.12.0

# Image tags used locally. The pipeline overrides them with the ACR tags.
TYK_GATEWAY_IMAGE=poc-tyk-gateway:local
TYK_PUMP_IMAGE=poc-tyk-pump:local

# Admin API secret (x-tyk-authorization header) and node secret.
# Both MUST be replaced with random values, they grant full control of the
# gateway administrative API.
TYK_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
TYK_NODE_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# Port published on the host and port the gateway listens on inside the
# container. In Azure the ingress always publishes 443 towards the internet.
TYK_PORT=8443
TYK_LISTEN_PORT=8080

# TLS terminated by the gateway itself. true for local development with the
# certificates generated by scripts/generate-local-certs.sh, false in Azure
# Container Apps where the managed ingress terminates TLS.
TYK_HTTP_USE_SSL=true

# Organisation id used in the API definitions and in the provisioned keys.
TYK_ORG_ID=poc-organization

# =============================================================================
# Tyk Gateway - logging and analytics
# =============================================================================

# debug | info | warn | error
TYK_LOG_LEVEL=info
TYK_GW_LOGFORMAT=json
TYK_GW_ACCESSLOGS_ENABLED=true
TYK_GW_ACCESSLOGS_TEMPLATE=method,path,status,latency_total,latency_gateway,upstream_latency,trace_id,api_id,api_key,client_ip,user_agent,upstream_status,upstream_addr
TYK_GW_TRACK404LOGS=false

# Analytics records consumed by Tyk Pump.
TYK_ENABLE_ANALYTICS=true

# Detailed recording stores full request and response bodies in Redis.
# Keep it false unless you accept storing potential PII.
TYK_ENABLE_DETAILED_RECORDING=false

# Log shipping transport. Locally the docker fluentd driver is used, so the
# logstash transport stays disabled. The Azure deployment sets it to true.
TYK_GW_USE_LOGSTASH=false
TYK_GW_LOGSTASH_TRANSPORT=tcp
TYK_GW_LOGSTASH_ADDR=otel-collector:5170

# =============================================================================
# Tyk Gateway - OpenTelemetry traces
# =============================================================================

TYK_GW_OTEL_ENABLED=true
TYK_GW_OTEL_EXPORTER=grpc
TYK_GW_OTEL_ENDPOINT=otel-collector:4317
TYK_GW_OTEL_RESOURCE_NAME=tyk-gateway
TYK_GW_OTEL_CONTEXT_PROPAGATION=tracecontext
TYK_GW_OTEL_CONNECTION_TIMEOUT=10
TYK_GW_OTEL_CUSTOM_TRACE_HEADERS=X-Request-ID,X-B3-Traceid,X-B3-Spanid,X-B3-Parentspanid,X-B3-Sampled,X-B3-Flags,traceparent,tracestate

# Per API span detail. Increases span volume in New Relic.
TYK_DETAILED_TRACING=true

# =============================================================================
# Tyk Pump
# =============================================================================

TYK_PUMP_VERSION=v1.12.0
TYK_PUMP_PURGE_DELAY=10
TYK_PUMP_LOG_LEVEL=info

# =============================================================================
# Upstream microservices (Basic Auth towards the backend)
# -----------------------------------------------------------------------------
# These credentials are injected by the gateway entrypoint into the API
# definitions at start up. They never touch a versioned file.
# =============================================================================

UPSTREAM_USERS_TARGET_URL=https://CHANGE_ME_USERS_UPSTREAM_HOST
UPSTREAM_USERS_BASIC_USER=CHANGE_ME_UPSTREAM_USERS_USER
UPSTREAM_USERS_BASIC_PASSWORD=CHANGE_ME_UPSTREAM_USERS_PASSWORD

UPSTREAM_ORDERS_TARGET_URL=https://CHANGE_ME_ORDERS_UPSTREAM_HOST
UPSTREAM_ORDERS_BASIC_USER=CHANGE_ME_UPSTREAM_ORDERS_USER
UPSTREAM_ORDERS_BASIC_PASSWORD=CHANGE_ME_UPSTREAM_ORDERS_PASSWORD

# =============================================================================
# Consumer credentials provisioned in the gateway (Basic Auth towards Tyk)
# -----------------------------------------------------------------------------
# Used by provision_key.sh to create the keys that clients present to the
# gateway. Do not reuse the upstream credentials here.
# =============================================================================

USERNAME_API_USERS=CHANGE_ME_GATEWAY_USERS_CONSUMER
PASSWORD_API_USERS=CHANGE_ME_GATEWAY_USERS_CONSUMER_PASSWORD

USERNAME_API_ORDERS=CHANGE_ME_GATEWAY_ORDERS_CONSUMER
PASSWORD_API_ORDERS=CHANGE_ME_GATEWAY_ORDERS_CONSUMER_PASSWORD

# =============================================================================
# Local scripts
# =============================================================================

# Base URL used by provision_key.sh and the smoke test scripts.
GATEWAY_BASE_URL=https://localhost:8443

# Set to true only for local self signed certificates.
GATEWAY_ALLOW_INSECURE_TLS=true

# Common name used by scripts/generate-local-certs.sh
LOCAL_CERT_CN=localhost
